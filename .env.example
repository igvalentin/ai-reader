# Supabase (public/anon — safe to expose to the browser via Vite's VITE_ prefix)
VITE_EXTERNAL_SUPABASE_URL=https://your-project.supabase.co
VITE_EXTERNAL_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-side only secrets (future phases: entitlement checks, TTS, billing webhooks).
# NEVER prefix these with VITE_ and NEVER commit real values.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# OCR (server-side only — used by the /api/ocr Vercel Function, never exposed to the client).
# OCR_SPACE_API_KEY=your-ocr-space-api-key
