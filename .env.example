# Platform environment
# Copy to .env.local and override per environment (development / preview / production).
# All VITE_* values are inlined into the client bundle at build time.

VITE_APP_ENV=development

# Site identity
VITE_SITE_NAME=Alevanta
VITE_SITE_TAGLINE=Alege cu avantaj.
VITE_SITE_DESCRIPTION=Alevanta reunește calculatoare și instrumente practice pentru decizii mai bune.
VITE_SITE_URL=https://alevanta.info
VITE_SITE_LOCALE=en
VITE_SITE_TWITTER=@alevanta
VITE_CONTACT_EMAIL=contact@alevanta.info

# Analytics / ads (optional)
VITE_GA_ID=
VITE_CLARITY_ID=
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_CLIENT=

# Consent mechanism: "google_cmp" (Google Funding Choices / IAB TCF v2.2) or "native"
VITE_CONSENT_MODE=google_cmp
