# Supabase (public/anon — safe to expose to the browser via Vite's VITE_ prefix)
VITE_EXTERNAL_SUPABASE_URL=https://your-project.supabase.co
VITE_EXTERNAL_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-side-only settings and keys. NEVER prefix secrets with VITE_ or commit real values.
# SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
# SUPABASE_URL=https://your-project.supabase.co
# Required by server-side bearer-token validation; use the anon/publishable key for the same project.
# SUPABASE_ANON_KEY=your-project-anon-key
# ANONYMOUS_USAGE_SECRET=generate-a-long-random-server-secret
# APP_URL=https://your-deployed-domain.example
# Comma-separated Supabase auth user IDs; never accept roles from client input.
# ADMIN_USER_IDS=trusted-user-uuid
# CRON_SECRET=generate-a-separate-long-random-secret

# Stripe: create recurring RON Prices in Stripe Test mode first. Do not use live values until approved.
# STRIPE_SECRET_KEY=your-stripe-test-secret-key
# STRIPE_PRICE_ID_7_DAYS=price_for_5_ron_every_7_days
# STRIPE_PRICE_ID_30_DAYS=price_for_10_ron_every_30_days
# STRIPE_PRICE_ID_1_YEAR=price_for_100_ron_per_year
# STRIPE_WEBHOOK_SECRET=your-stripe-test-webhook-secret

# OCR runs locally with Tesseract.js and the Romanian model; no OCR API key is required.

# Azure AI Speech (server-side only — never use a VITE_ prefix; do not commit real values).
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=germanywestcentral
# Optional Romanian neural voice (default: ro-RO-AlinaNeural).
# AZURE_SPEECH_VOICE=ro-RO-AlinaNeural
