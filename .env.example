# Supabase (public/anon — safe to expose to the browser via Vite's VITE_ prefix)
VITE_EXTERNAL_SUPABASE_URL=https://your-project.supabase.co
VITE_EXTERNAL_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# Server-side only secrets. NEVER prefix these with VITE_ and NEVER commit real values.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# ANONYMOUS_USAGE_SECRET=long-random-server-secret
# APP_URL=https://your-approved-domain.example

# Stripe test/live values are configured only after approval; use test mode first.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PRICE_ID=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# OCR runs locally with Tesseract.js and the Romanian model; no OCR API key is required.

# Azure AI Speech (server-side only — never use a VITE_ prefix; do not commit real values).
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=germanywestcentral
# Optional Romanian neural voice (default: ro-RO-AlinaNeural).
# AZURE_SPEECH_VOICE=ro-RO-AlinaNeural
