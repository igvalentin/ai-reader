{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/ocr.ts": {
      "includeFiles": "node_modules/{@tesseract.js-data/ron/4.0.0_best_int/ron.traineddata.gz,tesseract.js-core/*.wasm}"
    }
  },
  "crons": [{ "path": "/api/cron/usage-retention", "schedule": "0 4 * * *" }],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
